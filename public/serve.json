{
  "cleanUrls": true,
  "trailingSlash": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/getQuote/:slug", "destination": "/getQuote.html" },
    { "source": "/products/category/:cat/:sub", "destination": "/products/category/:cat/:sub.html" },
    { "source": "/products/category/:cat", "destination": "/products/category/:cat.html" },
    { "source": "/brand/:slug", "destination": "/brand/:slug.html" },
    { "source": "/product/:slug", "destination": "/product/:slug.html" }
  ]
}
